# ============================================================
# PAS Bandara — Konfigurasi Environment (contoh / template)
# Salin ke .env dan isi nilai nyata. JANGAN commit .env.
# ============================================================

# Pilih environment: development | production
DJANGO_ENV=development

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# Database
#   DB_ENGINE: sqlite | mysql
# ------------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=pas_bandara
DB_USER=pas_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Host yang diizinkan (pisahkan koma)
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------
# Pembayaran (§14.2) — ganti provider sesuai PSP/PJP
# ------------------------------------------------------------------
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=

# URL publik untuk verifikasi QR (§17)
PAS_BASE_URL=https://pas.bandara.example

# ------------------------------------------------------------------
# Production (opsional)
# ------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://pas.bandara.example

# Email SMTP (opsional)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Redis (opsional)
# REDIS_URL=redis://redis:6379/0
