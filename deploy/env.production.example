# ============================================================
# PAS Bandara — Production environment (contoh)
# Salin ke .env.production dan isi nilai nyata. JANGAN commit.
# ============================================================

# Django
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=change-me-long-random
ALLOWED_HOSTS=pas.lop-aoch.online,38.172.143.104

# MariaDB (di dalam docker network, host=db)
DB_ENGINE=mysql
DB_NAME=pas_bandara
DB_USER=pas_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_HOST=db
DB_PORT=3306

# Port HTTP/HTTPS yang dibuka nginx
HTTP_PORT=80
HTTPS_PORT=443

# Backup
BACKUP_CRON=0 2 * * *
BACKUP_RETAIN_DAYS=14

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Pembayaran
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=

# URL publik verifikasi QR
PAS_BASE_URL=https://pas.lop-aoch.online

# Security
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://pas.lop-aoch.online,http://38.172.143.104
